# ── Convivia24 environment ──────────────────────────────────────────────
# Copy to .env.local for development. Netlify holds the production values.
# Required launch settings are checked in Admin → Launch readiness.

# Database (Neon Postgres). Required.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# App identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@convivia24.com
SUPPORT_EMAIL=support@convivia24.com
NEXT_PUBLIC_EVENTS_ENABLED=true

# Auth (Neon Auth). NEON_AUTH_COOKIE_SECRET also signs the 18+ gate cookie — 32+ chars.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Admin desk: only these Neon Auth account emails may access admin (comma-separated). No app email verification step.
ALLOW_MANUAL_PAYMENTS=false
# Legacy supplier session signing fallback only; grants no admin access.
ADMIN_PASSWORD=
CONVIVIA_ADMIN_EMAILS=bobbynathus@yahoo.com,collinsenofe@gmail.com
ADMIN_NOTIFY_EMAIL=bobbynathus@yahoo.com,collinsenofe@gmail.com

# Supplier portal session signing (falls back to ADMIN_PASSWORD if unset).
SUPPLIER_SESSION_SECRET=

# Scheduled jobs (Netlify function → /api/cron/*). Any long random string.
CRON_SECRET=

# Payments (Flutterwave). FLW_* are accepted aliases.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM="Convivia24 <hello@convivia24.com>"
RESEND_REPLY_TO=
RESEND_API_URL=https://api.resend.com

# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=generic
TERMII_API_URL=https://api.ng.termii.com/api

# Rate limiting + caches (Upstash Redis). Production request limits fail closed when unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI (Azure OpenAI): product copy, trivia drafts, cocktail maker, price-list scans.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_ANALYSIS_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Images: bottle uploads (Azure Blob) and the public bottle-shot CDN base.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
NEXT_PUBLIC_AZURE_DRINK_BASE=
NEXT_PUBLIC_AZURE_DRINK_SAS=

# Error reporting (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
